module(
    name = "homebot",
    version = "0.1.0",
)

# C++ build dependencies only.
# Python is managed by uv (pyproject.toml + uv.lock), NOT Bazel — see ADR-001 in NOTES.md.

bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_shell", version = "0.6.1")

# Hermetic LLVM toolchain for cross-compiling to the Firefly aarch64 board.
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

# Pinned aarch64 Linux sysroot (target headers + libc/libstdc++) for cross-compilation.
# Debian Bullseye (glibc 2.31) — older than the board's Ubuntu 22.04 (glibc 2.35),
# so binaries built against it run on the board. See ADR-001.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sysroot_linux_aarch64",
    build_file_content = """
filegroup(
    name = "sysroot",
    srcs = glob(["*/**"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "d303cf3faf7804c9dd24c9b6b167d0345d41d7fe4bfb7d34add3ab342f6a236c",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/toolchain/906cc7c6bf47d4bd969a3221fc0602c6b3153caa/debian_bullseye_arm64_sysroot.tar.xz"],
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    # 17.0.6 ships an Ubuntu-22.04 prebuilt that links libtinfo.so.6 (the host lib).
    # Older versions (e.g. 16.0.0) only have an 18.04 build needing libtinfo.so.5,
    # which is absent on Ubuntu 22.04+ and breaks the compiler. See ADR-001.
    llvm_version = "17.0.6",
)

# Bind the sysroot to the aarch64 target so an aarch64 cc toolchain gets registered.
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_aarch64//:sysroot",
    targets = ["linux-aarch64"],
)
use_repo(llvm, "llvm_toolchain")

# Register the toolchains so Bazel can resolve them (incl. the aarch64 cross target).
register_toolchains("@llvm_toolchain//:all")

# OpenTelemetry SDK
bazel_dep(name = "opentelemetry-cpp", version = "1.27.0")

# Google Tests
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# ZeroMQ for IPC
bazel_dep(name = "cppzmq", version = "4.10.0.bcr.2")
bazel_dep(name = "libzmq", version = "4.3.5.bcr.5")

# OpenCV
bazel_dep(name = "opencv", version = "5.0.0")

# Formatter
bazel_dep(name = "aspect_rules_lint", version = "1.12.0")
# needed to resolve transitive dependency running formatter
bazel_dep(name = "rules_nodejs", version = "6.7.5") 

