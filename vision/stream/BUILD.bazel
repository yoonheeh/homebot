load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//scripts:deploy.bzl", "deploy", "deploy_uv")
load("//scripts:remote_test.bzl", "remote_cc_check", "remote_hardware_check")

filegroup(
    name = "config",
    srcs = ["vision_config.json"],
)

cc_library(
    name = "streamers",
    hdrs = [
        "base_streamer.hpp",
        "depth_streamer.hpp",
        "rgb_streamer.hpp",
    ],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    data = [":config"],
    linkstatic = True,
    deps = [
        "//third_party/depthai:depthai-core",
        "@cppzmq",
        "@libzmq",
        "@opencv",
    ],
)

cc_binary(
    name = "oakd_streamer",
    srcs = ["main.cpp"],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    data = [":config"],
    linkopts = [
        "-lpthread",
        "-ldl",
        "-lm",
    ],
    deps = [
        ":streamers",
        "@nlohmann_json//:json",
    ],
)

deploy(
    name = "deploy_oakd_streamer",
    binary = ":oakd_streamer",
    data = [":config"],
)

deploy_uv(
    name = "deploy_flask_server",
    srcs = [
        "server.py",
        "//:pyproject.toml",
        "//:uv.lock",
    ],
    data = [":config"],
    main_script = "server.py",
    remote_dir = "~/homebot/flask_stream",
)

cc_binary(
    name = "streamer_benchmark_bin",
    srcs = ["tests/streamer_benchmark.cpp"],
    deps = [
        "@google_benchmark//:benchmark",
        "@google_benchmark//:benchmark_main",
        # "//third_party:zmq", # Add this when benchmarking ZMQ
    ],
)

remote_cc_check(
    name = "streamer_benchmark",
    binary = ":streamer_benchmark_bin",
    data = [":config"],
    remote_dir = "~/homebot/bin/benchmarks",
)

remote_hardware_check(
    name = "remote_hardware_check",
    data = [
        ":config",
        "//:pyproject.toml",
        "//:uv.lock",
    ],
    test_script = "test_vision_pipeline.py",
)
