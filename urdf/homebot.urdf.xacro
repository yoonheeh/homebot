<?xml version="1.0"?>
<robot name="homebot" xmlns:xacro="http://ros.org/wiki/xacro">
	<link name="world"/>
  <link name="base_footprint"/>

  <!-- ======================== -->
  <!-- 1. PHYSICAL PROPERTIES   -->
  <!-- ======================== -->
  <!-- Base dimensions in meters, mass in kg -->
  <xacro:property name="base_width" value="0.08"/>
  <xacro:property name="base_length" value="0.22"/>
  <xacro:property name="base_height" value="0.11"/>
  <xacro:property name="base_mass" value="1.0"/> <!-- including battery, compute and motors -->

  <!-- Wheel dimensions in meters, mass in kg -->
  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.15"/>

  <!-- Wheel placement offsets from the center of the base -->
  <xacro:property name="wheel_offset_x" value="0.05"/> <!-- Distance from center to front/rear axis -->
  <xacro:property name="wheel_offset_y" value="0.065"/> <!-- Distance from center to left/right wheel center -->
  <xacro:property name="wheel_offset_z" value="-0.03"/> <!-- Drop the wheels slightly below the chassis -->

  <!-- OAK-D Lite Camera dimensions in meters, mass in kg -->
  <xacro:property name="camera_length" value="0.0175"/> <!-- X: Depth -->
  <xacro:property name="camera_width" value="0.091"/>   <!-- Y: Width -->
  <xacro:property name="camera_height" value="0.028"/>  <!-- Z: Height -->
  <xacro:property name="camera_mass" value="0.061"/>

  <!-- Camera placement offsets from the center of the base_link -->
  <xacro:property name="camera_offset_x" value="0.11"/> <!-- Distance forward to the mount -->
  <xacro:property name="camera_offset_y" value="0.0"/>  <!-- Centered on the chassis (0.0) -->
  <xacro:property name="camera_offset_z" value="0.23"/> <!-- Distance up from the center (mounting height) -->

  <!-- Camera tilt (Pitch) in radians. Use 0 if looking straight ahead. -->
  <xacro:property name="camera_pitch" value="0.0"/> <!-- e.g., 0.2618 for a 15-degree downward tilt -->

  <!-- ======================================================== -->
  <!-- 2. INERTIA MACROS (Standard mathematical formulas)       -->
  <!-- ======================================================== -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0" 
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0" 
               izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0" 
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0" 
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ======================================================== -->
  <!-- 3. BASE LINK (The main chassis)                          -->
  <!-- ======================================================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" w="${base_width}" h="${base_height}" d="${base_length}"/>
  </link>

  <joint name="floating_base" type="floating">
    <parent link="world"/>
    <child link="base_footprint"/>
  </joint>

  <joint name="base_joint" type="fixed">
    <!-- Adjust the Z origin to whatever height your chassis sits off the ground -->
    <origin xyz="0 0 0.063" rpy="0 0 0"/> 
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- ======================================================== -->
  <!-- 4. WHEEL MACRO                                           -->
  <!-- ======================================================== -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <!-- Rotate the cylinder so it lays flat against the chassis -->
        <origin xyz="0 0 0" rpy="0 0 0"/> 
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <!-- The joint acts as physical motor axis -->
    <joint name="${prefix}_wheel_joint" type="revolute">
      <parent link="base_link"/>	
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_reflect * wheel_offset_x} ${y_reflect * wheel_offset_y} ${wheel_offset_z}" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-inf" upper="inf" velocity="inf"/>
      <dynamics friction="0"/>
      <!-- isaac:source_drive {"armature": 0.0, "drive": {"damping": 100000.0, "max_force": 3.4028234663852886e+38, "stiffness": 0.0, "target_position": 0.0}, "instance": "angular", "source": "physx"} -->
    </joint>
  </xacro:macro>

  <!-- ======================================================== -->
  <!-- 5. INSTANTIATE THE 4 WHEELS                              -->
  <!-- ======================================================== -->
  <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
  <xacro:wheel prefix="rear_left" x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right" x_reflect="-1" y_reflect="-1"/>

  <!-- ======================================================== -->
  <!-- 6. CAMERA (OAK-D Lite)                                   -->
  <!-- ======================================================== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${camera_mass}" w="${camera_width}" h="${camera_height}" d="${camera_length}"/>
  </link>

  <!-- The fixed joint rigidly attaches the camera to the chassis -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- XYZ sets the physical location. RPY sets the orientation (Roll, Pitch, Yaw). -->
    <!-- Pitch rotates around the Y axis, tilting the camera up or down. -->
    <origin xyz="${camera_offset_x} ${camera_offset_y} ${camera_offset_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>

</robot>
