#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "homebot"
    doc = """Generated from Composed Stage of root layer /tmp/tmp2t8sc99n/homebot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_homebot_f4j2exn9/usdex_homebot/homebot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_homebot_f4j2exn9/temp_homebot/homebot.usd


Generated from Composed Stage of root layer /home/yoonhee/homebot/urdf/homebot/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "homebot"
{
    over "Physics"
    {
        def MjcActuator "front_left_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </homebot/Physics/front_left_wheel_joint>
        }

        def MjcActuator "front_right_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </homebot/Physics/front_right_wheel_joint>
        }

        def MjcActuator "rear_left_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </homebot/Physics/rear_left_wheel_joint>
        }

        def MjcActuator "rear_right_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </homebot/Physics/rear_right_wheel_joint>
        }

        over "base_joint"
        {
        }

        over "front_left_wheel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "front_right_wheel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "rear_left_wheel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "rear_right_wheel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "camera_joint"
        {
        }
    }

    over "Geometry"
    {
        over "world"
        {
            over "base_footprint"
            {
                over "base_link"
                {
                    over "front_left_wheel"
                    {
                        over "cylinder"
                        {
                        }

                        over "cylinder_1"
                        {
                        }
                    }

                    over "front_right_wheel"
                    {
                        over "cylinder"
                        {
                        }

                        over "cylinder_1"
                        {
                        }
                    }

                    over "rear_left_wheel"
                    {
                        over "cylinder"
                        {
                        }

                        over "cylinder_1"
                        {
                        }
                    }

                    over "rear_right_wheel"
                    {
                        over "cylinder"
                        {
                        }

                        over "cylinder_1"
                        {
                        }
                    }

                    over "camera_link"
                    {
                        over "box"
                        {
                        }

                        over "box_1"
                        {
                        }
                    }

                    over "box"
                    {
                    }

                    over "box_1"
                    {
                    }
                }
            }
        }
    }

    over "Materials"
    {
        over "gray"
        {
        }

        over "black"
        {
        }

        over "white"
        {
        }
    }
}

