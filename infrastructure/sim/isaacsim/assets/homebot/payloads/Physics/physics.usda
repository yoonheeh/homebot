                        over "cylinder_1" (
                            prepend apiSchemas = ["NewtonCollisionAPI"]
                        )
                        {
                        }
                    }

                    over "rear_right_wheel" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        float3 physics:diagonalInertia = (0.0000678125, 0.0000678125, 0.00012)
                        float physics:mass = 0.15
                        quatf physics:principalAxes = (1, 0, 0, 0)

                        over "cylinder_1" (
                            prepend apiSchemas = ["NewtonCollisionAPI"]
                        )
                        {
                        }
                    }

                    over "camera_link" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        float3 physics:diagonalInertia = (0.000005542104, 0.000043651853, 0.000046080415)
                        float physics:mass = 0.061
                        quatf physics:principalAxes = (1, 0, 0, 0)

                        over "box_1" (
                            prepend apiSchemas = ["NewtonCollisionAPI"]
                        )
                        {
                        }
                    }

                    over "box_1" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "front_left_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </homebot/Geometry/world/base_footprint/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </homebot/Geometry/world/base_footprint/base_link/front_left_wheel>
            point3f physics:localPos0 = (0.05, 0.065, -0.03)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.70710546, 0.7071081, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -inf
            float physics:upperLimit = inf
            custom float urdf:dynamics:damping = 0
            custom float urdf:dynamics:friction = 0
            custom float urdf:limit:effort = 0
