"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "homebot"
{
    over "Geometry"
    {
        over "world"
        {
            over "base_footprint" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
            )
            {
                bool newton:selfCollisionEnabled = 0

                over "base_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    float3 physics:diagonalInertia = (0.0015416667, 0.0045666667, 0.005041667)
                    float physics:mass = 1
                    quatf physics:principalAxes = (0.70710677, 0, 0.70710677, 0)

                    over "front_left_wheel" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        float3 physics:diagonalInertia = (0.0000678125, 0.0000678125, 0.00012)
                        float physics:mass = 0.15
                        quatf physics:principalAxes = (1, 0, 0, 0)

                        over "cylinder_1" (
                            prepend apiSchemas = ["NewtonCollisionAPI"]
                        )
                        {
                        }
                    }

                    over "front_right_wheel" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
