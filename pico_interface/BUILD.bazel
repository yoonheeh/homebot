load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//scripts:deploy.bzl", "deploy")

cc_library(
    name = "pico_interface_lib",
    hdrs = glob(["include/pico_interface/**/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@opentelemetry-cpp//api",
    ],
)

cc_library(
    name = "control_lib",
    hdrs = glob(["include/pico_interface/**/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "fake_test",
    srcs = ["tests/fake_test.cpp"],
    copts = ["-std=c++20"],
    visibility = ["//visibility:public"],
    deps = [
        ":pico_interface_lib",
        "@googletest//:gtest_main",
        "@opentelemetry-cpp//api",
        "@opentelemetry-cpp//exporters/memory:in_memory_span_exporter",
        "@opentelemetry-cpp//exporters/ostream:ostream_span_exporter",
        "@opentelemetry-cpp//exporters/otlp:otlp_http_exporter",
        "@opentelemetry-cpp//sdk:headers",
        "@opentelemetry-cpp//sdk/src/metrics:metrics",
    ],
)

cc_binary(
    name = "control",  #TODO: rename?
    srcs = ["main.cpp"],
    copts = ["-std=c++20"],
    linkopts = ["-pthread"],
    visibility = ["//visibility:public"],
    deps = [
        ":control_lib",
        ":pico_interface_lib",
        "@cppzmq",
        "@libzmq",
    ],
)

cc_test(
    name = "test_controller",
    srcs = ["tests/test_controller.cpp"],
    copts = ["-std=c++20"],
    visibility = ["//visibility:public"],
    deps = [
        ":control_lib",
        ":pico_interface_lib",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "calibrate_encoders",
    srcs = ["calibrate_encoders.cpp"],
    copts = ["-std=c++20"],
    data = [":control"],
    linkopts = ["-pthread"],
    visibility = ["//visibility:public"],
    deps = [
        ":pico_interface_lib",
    ],
)

cc_binary(
    name = "test_client",
    srcs = ["tests/test_client.cpp"],
    copts = ["-std=c++20"],
    linkopts = ["-pthread"],
    visibility = ["//visibility:public"],
    deps = [
        "@cppzmq",
        "@libzmq",
    ],
)

deploy(
    name = "deploy_test_client",
    binary = ":test_client",
)

deploy(
    name = "deploy_control",
    binary = ":control",
)

deploy(
    name = "deploy_calibrate_encoders",
    binary = ":calibrate_encoders",
)
